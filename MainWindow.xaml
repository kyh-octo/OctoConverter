<Window x:Class="OctoConverter.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OctoConverter" Height="720" Width="1080"
        MinHeight="600" MinWidth="960"
        Icon="pack://application:,,,/Assets/OctoConverter.ico"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, Malgun Gothic"
        UseLayoutRounding="True"
        WindowStartupLocation="CenterScreen"
        Loaded="Window_Loaded">
    <Grid Margin="16,12,16,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 헤더 -->
        <DockPanel Grid.Row="0" Margin="4,0,4,10">
            <StackPanel Orientation="Horizontal">
                <Image Source="pack://application:,,,/Assets/OctoConverter.ico"
                       Width="26" Height="26" VerticalAlignment="Center" Margin="0,0,8,0"
                       RenderOptions.BitmapScalingMode="HighQuality"/>
                <TextBlock Text="OctoConverter" FontSize="20" FontWeight="Bold"
                           Foreground="{StaticResource TextBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="만능 파일 변환기" Foreground="{StaticResource TextSecondaryBrush}"
                           VerticalAlignment="Bottom" Margin="10,0,0,3"/>
            </StackPanel>
            <TextBlock x:Name="FFmpegStatus" HorizontalAlignment="Right" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </DockPanel>

        <!-- FFmpeg 미설치 안내 배너 -->
        <Border x:Name="FFmpegBanner" Grid.Row="1" Background="{StaticResource WarnBackBrush}"
                BorderBrush="{StaticResource WarnLineBrush}" BorderThickness="1" CornerRadius="8"
                Padding="12,8" Margin="0,0,0,10" Visibility="Collapsed">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="FFmpeg 자동 설치"
                        Style="{StaticResource PrimaryButton}" Click="InstallFFmpeg_Click"/>
                <TextBlock VerticalAlignment="Center" TextWrapping="Wrap"
                           Foreground="{StaticResource WarnTextBrush}" Margin="0,0,12,0"
                           Text="동영상·음악·애니메이션 변환에는 FFmpeg이 필요합니다. 버튼 한 번으로 자동 설치됩니다. (이미지·아이콘 변환은 바로 사용 가능)"/>
            </DockPanel>
        </Border>

        <!-- 탭: 내용은 처음 선택될 때 생성(시작 속도 확보) -->
        <TabControl x:Name="Tabs" Grid.Row="2" SelectionChanged="Tabs_SelectionChanged">
            <TabItem Header="🖼️ 이미지" Tag="image"/>
            <TabItem Header="🎞️ 애니메이션" Tag="animation"/>
            <TabItem Header="⭐ 아이콘" Tag="icon"/>
            <TabItem Header="📄 문서" Tag="document"/>
            <TabItem Header="🎵 음악" Tag="music"/>
            <TabItem Header="🎬 동영상" Tag="video"/>
        </TabControl>
    </Grid>
</Window>
