<Window x:Class="OctoConverter.FFmpegDownloadWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="FFmpeg 설치" Height="200" Width="480"
        Icon="pack://application:,,,/Assets/OctoConverter.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, Malgun Gothic"
        Loaded="Window_Loaded" Closing="Window_Closing">
    <StackPanel Margin="20" VerticalAlignment="Center">
        <TextBlock x:Name="StatusText" Text="준비 중..." Margin="0,0,0,10"
                   Foreground="{StaticResource TextBrush}"/>
        <ProgressBar x:Name="Progress" Maximum="100" Height="10"/>
        <TextBlock Foreground="{StaticResource TextSecondaryBrush}" FontSize="11" Margin="0,8,0,14"
                   TextWrapping="Wrap"
                   Text="BtbN FFmpeg 공식 빌드(win64, GPL)를 내려받습니다. 약 150~200MB이며 한 번만 설치하면 됩니다."/>
        <Button x:Name="CancelBtn" Content="취소" HorizontalAlignment="Right" Click="Cancel_Click"/>
    </StackPanel>
</Window>
