<UserControl x:Class="OctoConverter.Controls.OutputLocationControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Style="{StaticResource Card}" Padding="12,8">
        <StackPanel Orientation="Horizontal">
            <TextBlock Text="저장 위치" FontWeight="SemiBold" VerticalAlignment="Center"
                       Foreground="{StaticResource TextBrush}" Margin="0,0,14,0"/>
            <RadioButton x:Name="SameFolder" Content="원본과 같은 폴더" IsChecked="True" Margin="0,0,14,0"/>
            <RadioButton x:Name="CustomFolder" Content="지정 폴더:" Margin="0,0,6,0"/>
            <TextBox x:Name="FolderBox" Width="280" VerticalAlignment="Center"
                     IsEnabled="{Binding IsChecked, ElementName=CustomFolder}"/>
            <Button Content="찾아보기..." Margin="6,0,0,0" Click="Browse_Click"/>
        </StackPanel>
    </Border>
</UserControl>
