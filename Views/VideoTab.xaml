<UserControl x:Class="OctoConverter.Views.VideoTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OctoConverter.Controls"
             Loaded="Tab_Loaded">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:FileListControl x:Name="FileList" Grid.Row="0"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="변환 옵션" Style="{StaticResource SectionTitle}"/>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,8">
                        <TextBlock Text="출력 형식" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="FormatBox" Width="170" SelectedIndex="0" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="MP4 (H.264)" Tag="mp4-h264"/>
                            <ComboBoxItem Content="MP4 (H.265/HEVC)" Tag="mp4-h265"/>
                            <ComboBoxItem Content="MP4 (AV1)" Tag="mp4-av1"/>
                            <ComboBoxItem Content="MKV (H.264)" Tag="mkv"/>
                            <ComboBoxItem Content="MOV (H.264)" Tag="mov"/>
                            <ComboBoxItem Content="WebM (VP9)" Tag="webm"/>
                            <ComboBoxItem Content="AVI (MPEG-4/Xvid)" Tag="avi"/>
                            <ComboBoxItem Content="WMV" Tag="wmv"/>
                            <ComboBoxItem Content="MP3 (오디오만 추출)" Tag="mp3"/>
                            <ComboBoxItem Content="M4A (오디오만 추출)" Tag="m4a"/>
                            <ComboBoxItem Content="WAV (오디오만 추출)" Tag="wav"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="ResolutionPanel" Orientation="Horizontal" Margin="0,0,22,8">
                        <TextBlock Text="해상도" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ResolutionBox" Width="120" SelectedIndex="0" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="원본 유지" Tag="0"/>
                            <ComboBoxItem Content="4K (2160p)" Tag="2160"/>
                            <ComboBoxItem Content="QHD (1440p)" Tag="1440"/>
                            <ComboBoxItem Content="FHD (1080p)" Tag="1080"/>
                            <ComboBoxItem Content="HD (720p)" Tag="720"/>
                            <ComboBoxItem Content="SD (480p)" Tag="480"/>
                            <ComboBoxItem Content="360p" Tag="360"/>
                            <ComboBoxItem Content="사용자 지정" Tag="-1"/>
                        </ComboBox>
                        <TextBox x:Name="CustomW" Width="56" Margin="6,0,0,0" Text="1280"
                                 TextChanged="Option_Changed" Visibility="Collapsed"/>
                        <TextBlock x:Name="CustomX" Text="×" Margin="4,0" VerticalAlignment="Center"
                                   Visibility="Collapsed" Foreground="{StaticResource TextSecondaryBrush}"/>
                        <TextBox x:Name="CustomH" Width="56" Text="720"
                                 TextChanged="Option_Changed" Visibility="Collapsed"/>
                    </StackPanel>

                    <StackPanel x:Name="FpsPanel" Orientation="Horizontal" Margin="0,0,22,8">
                        <TextBlock Text="프레임(fps)" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="FpsBox" Width="90" SelectedIndex="0" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="원본 유지" Tag="0"/>
                            <ComboBoxItem Content="60" Tag="60"/>
                            <ComboBoxItem Content="30" Tag="30"/>
                            <ComboBoxItem Content="24" Tag="24"/>
                            <ComboBoxItem Content="15" Tag="15"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="AudioPanel" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="오디오" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="AudioBitrateBox" Width="90" SelectedIndex="1" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="192 kbps" Tag="192"/>
                            <ComboBoxItem Content="128 kbps" Tag="128"/>
                            <ComboBoxItem Content="96 kbps" Tag="96"/>
                            <ComboBoxItem Content="64 kbps" Tag="64"/>
                        </ComboBox>
                        <CheckBox x:Name="RemoveAudioCheck" Content="오디오 제거" Margin="10,0,0,0"
                                  Checked="Option_Changed" Unchecked="Option_Changed"/>
                    </StackPanel>
                </WrapPanel>

                <!-- 품질 모드 -->
                <StackPanel x:Name="QualityModePanel">
                    <Rectangle Height="1" Fill="{StaticResource LineBrush}" Margin="0,2,0,10"/>
                    <WrapPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                            <RadioButton x:Name="ModeCrf" GroupName="VideoMode" Content="품질 우선(CRF)"
                                         IsChecked="True" Margin="0,0,8,0" Checked="Option_Changed"/>
                            <Slider x:Name="CrfSlider" Width="120" Minimum="14" Maximum="40" Value="23"
                                    TickFrequency="1" IsSnapToTickEnabled="True" VerticalAlignment="Center"
                                    IsEnabled="{Binding IsChecked, ElementName=ModeCrf}"
                                    ValueChanged="Option_Changed"/>
                            <TextBlock Text="{Binding Value, ElementName=CrfSlider, StringFormat={}{0:0}}"
                                       VerticalAlignment="Center" Margin="6,0,0,0" Width="22"
                                       Foreground="{StaticResource TextBrush}"/>
                            <TextBlock Text="(낮을수록 고화질·대용량)" Style="{StaticResource FieldLabel}" Margin="6,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,24,6">
                            <RadioButton x:Name="ModeBitrate" GroupName="VideoMode" Content="비트레이트"
                                         Margin="0,0,6,0" Checked="Option_Changed"/>
                            <TextBox x:Name="BitrateBox" Width="66" Text="4000" TextChanged="Option_Changed"
                                     IsEnabled="{Binding IsChecked, ElementName=ModeBitrate}"/>
                            <TextBlock Text="kbps" Style="{StaticResource FieldLabel}" Margin="4,0,0,0"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                            <RadioButton x:Name="ModeTarget" GroupName="VideoMode" Content="목표 용량"
                                         Margin="0,0,6,0" Checked="Option_Changed"/>
                            <TextBox x:Name="TargetSizeBox" Width="56" Text="50" TextChanged="Option_Changed"
                                     IsEnabled="{Binding IsChecked, ElementName=ModeTarget}"/>
                            <TextBlock Text="MB (2-pass 인코딩으로 자동 맞춤)" Style="{StaticResource FieldLabel}"
                                       Margin="4,0,0,0"/>
                        </StackPanel>
                    </WrapPanel>
                </StackPanel>
            </StackPanel>
        </Border>

        <controls:OutputLocationControl x:Name="Output" Grid.Row="2" Margin="0,10,0,0"/>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelBtn" Content="중지" Visibility="Collapsed"
                        Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="ConvertBtn" Content="변환 시작" Style="{StaticResource PrimaryButton}"
                        Click="Convert_Click"/>
            </StackPanel>
            <TextBlock x:Name="EstimateText" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</UserControl>
