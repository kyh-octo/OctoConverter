<UserControl x:Class="OctoConverter.Views.IconTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OctoConverter.Controls">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:FileListControl x:Name="FileList" Grid.Row="0"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="아이콘 옵션" Style="{StaticResource SectionTitle}"/>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="포함할 크기(px)" Style="{StaticResource FieldLabel}" Margin="0,0,10,0"/>
                    <CheckBox x:Name="Size16" Content="16" IsChecked="True" Margin="0,0,12,0"/>
                    <CheckBox x:Name="Size24" Content="24" Margin="0,0,12,0"/>
                    <CheckBox x:Name="Size32" Content="32" IsChecked="True" Margin="0,0,12,0"/>
                    <CheckBox x:Name="Size48" Content="48" IsChecked="True" Margin="0,0,12,0"/>
                    <CheckBox x:Name="Size64" Content="64" Margin="0,0,12,0"/>
                    <CheckBox x:Name="Size128" Content="128" Margin="0,0,12,0"/>
                    <CheckBox x:Name="Size256" Content="256" IsChecked="True" Margin="0,0,12,0"/>
                    <TextBlock Text="· 선택한 크기가 모두 한 개의 ICO 파일에 포함됩니다"
                               Style="{StaticResource FieldLabel}"/>
                </StackPanel>
                <TextBlock Margin="0,8,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                           Text="비율은 유지되고 남는 부분은 투명하게 처리됩니다. 정사각형에 가까운 이미지일수록 결과가 좋습니다."/>
            </StackPanel>
        </Border>

        <controls:OutputLocationControl x:Name="Output" Grid.Row="2" Margin="0,10,0,0"/>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelBtn" Content="중지" Visibility="Collapsed"
                        Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="ConvertBtn" Content="ICO 만들기" Style="{StaticResource PrimaryButton}"
                        Click="Convert_Click"/>
            </StackPanel>
            <TextBlock x:Name="EstimateText" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}"/>
        </DockPanel>
    </Grid>
</UserControl>
