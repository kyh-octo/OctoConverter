<UserControl x:Class="OctoConverter.Views.MusicTab"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:OctoConverter.Controls"
             Loaded="Tab_Loaded">
    <Grid Margin="0,12,0,0">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <controls:FileListControl x:Name="FileList" Grid.Row="0"/>

        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0">
            <StackPanel>
                <TextBlock Text="변환 옵션" Style="{StaticResource SectionTitle}"/>
                <WrapPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,0,22,6">
                        <TextBlock Text="출력 형식" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="FormatBox" Width="150" SelectedIndex="0" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="MP3" Tag=".mp3"/>
                            <ComboBoxItem Content="M4A (AAC)" Tag=".m4a"/>
                            <ComboBoxItem Content="Opus" Tag=".opus"/>
                            <ComboBoxItem Content="OGG (Vorbis)" Tag=".ogg"/>
                            <ComboBoxItem Content="WAV (무손실)" Tag=".wav"/>
                            <ComboBoxItem Content="FLAC (무손실)" Tag=".flac"/>
                            <ComboBoxItem Content="ALAC (M4A 무손실)" Tag=".alac"/>
                            <ComboBoxItem Content="AIFF (무손실)" Tag=".aiff"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel x:Name="BitratePanel" Orientation="Horizontal" Margin="0,0,22,6">
                        <RadioButton x:Name="ModeBitrate" GroupName="MusicMode" Content="비트레이트"
                                     IsChecked="True" Margin="0,0,6,0" Checked="Option_Changed"/>
                        <ComboBox x:Name="BitrateBox" Width="90" SelectedIndex="3" SelectionChanged="Option_Changed"
                                  IsEnabled="{Binding IsChecked, ElementName=ModeBitrate}">
                            <ComboBoxItem Content="96 kbps" Tag="96"/>
                            <ComboBoxItem Content="128 kbps" Tag="128"/>
                            <ComboBoxItem Content="160 kbps" Tag="160"/>
                            <ComboBoxItem Content="192 kbps" Tag="192"/>
                            <ComboBoxItem Content="256 kbps" Tag="256"/>
                            <ComboBoxItem Content="320 kbps" Tag="320"/>
                        </ComboBox>
                        <RadioButton x:Name="ModeTarget" GroupName="MusicMode" Content="목표 용량"
                                     Margin="14,0,6,0" Checked="Option_Changed"/>
                        <TextBox x:Name="TargetSizeBox" Width="56" Text="10" TextChanged="Option_Changed"
                                 IsEnabled="{Binding IsChecked, ElementName=ModeTarget}"/>
                        <TextBlock Text="MB (비트레이트 자동 계산)" Style="{StaticResource FieldLabel}" Margin="4,0,0,0"/>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,22,6">
                        <TextBlock Text="샘플레이트" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="SampleRateBox" Width="94" SelectedIndex="0" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="원본 유지" Tag="0"/>
                            <ComboBoxItem Content="44.1 kHz" Tag="44100"/>
                            <ComboBoxItem Content="48 kHz" Tag="48000"/>
                        </ComboBox>
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Margin="0,0,22,6">
                        <TextBlock Text="채널" Style="{StaticResource FieldLabel}"/>
                        <ComboBox x:Name="ChannelBox" Width="94" SelectedIndex="0" SelectionChanged="Option_Changed">
                            <ComboBoxItem Content="원본 유지" Tag="0"/>
                            <ComboBoxItem Content="스테레오" Tag="2"/>
                            <ComboBoxItem Content="모노" Tag="1"/>
                        </ComboBox>
                    </StackPanel>

                    <CheckBox x:Name="LoudnormCheck" Content="음량 평준화 (loudnorm)" Margin="0,0,0,6"/>
                </WrapPanel>
                <TextBlock Margin="0,4,0,0" Foreground="{StaticResource TextSecondaryBrush}" FontSize="11"
                           Text="동영상 파일(MP4·MKV 등)을 넣으면 오디오만 추출해 변환합니다. 목표 용량은 MP3·M4A·Opus·OGG에서 사용할 수 있습니다."/>
            </StackPanel>
        </Border>

        <controls:OutputLocationControl x:Name="Output" Grid.Row="2" Margin="0,10,0,0"/>

        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="CancelBtn" Content="중지" Visibility="Collapsed"
                        Click="Cancel_Click" Margin="0,0,8,0"/>
                <Button x:Name="ConvertBtn" Content="변환 시작" Style="{StaticResource PrimaryButton}"
                        Click="Convert_Click"/>
            </StackPanel>
            <TextBlock x:Name="EstimateText" VerticalAlignment="Center"
                       Foreground="{StaticResource TextSecondaryBrush}" TextTrimming="CharacterEllipsis"/>
        </DockPanel>
    </Grid>
</UserControl>
