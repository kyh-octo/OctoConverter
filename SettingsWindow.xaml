<Window x:Class="OctoConverter.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="설정" Width="500" SizeToContent="Height"
        Icon="pack://application:,,,/Assets/OctoConverter.ico"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}"
        FontFamily="Segoe UI Variable, Segoe UI, Malgun Gothic"
        UseLayoutRounding="True">
    <StackPanel Margin="20,16,20,16">
        <TextBlock Text="업데이트" Style="{StaticResource SectionTitle}"/>
        <Border Style="{StaticResource Card}">
            <StackPanel>
                <CheckBox x:Name="ChkAutoUpdate" Content="시작할 때 자동으로 업데이트 확인"
                          Foreground="{StaticResource TextBrush}"/>
                <TextBlock x:Name="TxtUpdateStatus" Margin="0,10,0,0" TextWrapping="Wrap"
                           Foreground="{StaticResource TextBrush}"/>
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                    <Button x:Name="BtnCheckUpdate" Content="업데이트 확인" Click="CheckUpdate_Click"/>
                    <Button x:Name="BtnInstallUpdate" Content="업데이트 설치" Style="{StaticResource PrimaryButton}"
                            Padding="12,6" Margin="8,0,0,0" IsEnabled="False" Click="InstallUpdate_Click"/>
                    <TextBlock VerticalAlignment="Center" Margin="14,0,0,0">
                        <Hyperlink Click="ReleaseNotes_Click" Foreground="{StaticResource AccentBrush}">변경 내역 보기</Hyperlink>
                    </TextBlock>
                </StackPanel>
            </StackPanel>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="확인" Style="{StaticResource PrimaryButton}" MinWidth="90" Padding="12,6" Click="Ok_Click"/>
            <Button Content="취소" MinWidth="90" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
